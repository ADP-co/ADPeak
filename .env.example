# Valores de ejemplo para desarrollo local. No usar secretos reales aqui.
APP_ENV=development
FRONTEND_PORT=5173
BACKEND_PORT=8000
PUBLIC_APP_URL=http://127.0.0.1:5173
INTERNAL_API_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ORIGIN=http://127.0.0.1:5173

POSTGRES_PORT=5432
POSTGRES_DB=sigi_poa_dev
POSTGRES_USER=sigi_poa
POSTGRES_PASSWORD=local_dev_password_not_secret
DATABASE_URL=postgresql://sigi_poa:local_dev_password_not_secret@127.0.0.1:5432/sigi_poa_dev

AUTH_SECRET=local-dev-auth-secret-change-me
INITIAL_DIRECTOR_PASSWORD=change-this-director-password
INITIAL_RESPONSABLE_PASSWORD=change-this-responsable-password
INITIAL_PLANTEL_PASSWORD=change-this-plantel-password
# Set a new unique value only for an explicitly authorized factory reset.
OFFICIAL_FACTORY_RESET_VERSION=
AUTH_TOKEN_TTL_MINUTES=60

FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=uploads
EVIDENCE_MAX_FILE_MB=25
SIGI_DATA_FILE=data/sigi-state.json
