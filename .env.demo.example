# Valores publicos de demo local. No contienen secretos reales.
APP_ENV=demo
FRONTEND_PORT=5173
BACKEND_PORT=8000
PUBLIC_APP_URL=http://127.0.0.1:5173
INTERNAL_API_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ORIGIN=http://127.0.0.1:5173

POSTGRES_PORT=5432
POSTGRES_DB=sigi_poa_demo
POSTGRES_USER=sigi_poa_demo
POSTGRES_PASSWORD=demo_local_password_not_secret
DATABASE_URL=postgresql://sigi_poa_demo:demo_local_password_not_secret@127.0.0.1:5432/sigi_poa_demo

AUTH_SECRET=demo-local-placeholder-not-secret
AUTH_TOKEN_TTL_MINUTES=60

FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=uploads-demo
EVIDENCE_MAX_FILE_MB=25
