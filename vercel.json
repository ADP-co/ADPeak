{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/frontend/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/v1/router?path=$1"
    },
    {
      "source": "/demo/(.*)",
      "destination": "/api/demo-endpoint?endpoint=disabled"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
